# DropLink Environment Configuration
VITE_APP_NAME="DropLink"

# Application URL
# In production on Vercel: https://droplink-app.vercel.app
# In local development: http://localhost:5173 (or your local IP: http://192.168.x.x:5173)
VITE_APP_URL="https://droplink-app.vercel.app"

# Production Cloudflare Signaling Server WebSocket URL:
# Defaults to: wss://droplink-signaling.fraidoonwalizada2.workers.dev
VITE_SIGNALING_SERVER_URL="wss://droplink-signaling.fraidoonwalizada2.workers.dev"

# STUN Server URL:
# Public STUN servers (Google and Cloudflare) are automatically configured by default.
# Specify a custom STUN server here if desired.
VITE_STUN_SERVER_URL="stun:stun.l.google.com:19302"

# TURN Server URL (Single):
# Required when connecting devices across different networks (e.g. PC Wi-Fi <-> Phone 4G/5G,
# symmetric NATs, or restrictive corporate firewalls) where direct UDP hole punching is blocked.
# Example: turn:turn.example.com:3478?transport=udp
VITE_TURN_SERVER_URL=""

# TURN Server URLs (Multiple, comma-separated):
# Use to specify multiple TURN transports (UDP, TCP, and TLS) for maximum compatibility.
# Example: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
VITE_TURN_SERVER_URLS=""

# TURN Server Username:
# The authentication username provided by your TURN server provider (e.g. Coturn, Twilio, Xirsys, Metered).
VITE_TURN_USERNAME=""

# TURN Server Credential:
# The authentication credential / secret password provided by your TURN server provider.
VITE_TURN_CREDENTIAL=""
