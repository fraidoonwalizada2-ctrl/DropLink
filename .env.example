# DropLink Environment Configuration
VITE_APP_NAME="DropLink"
VITE_APP_URL="http://localhost:5173"

# Node.js Signaling Server WebSocket URL:
# - In local development: Leave empty to automatically use Vite's /ws proxy on the active port (works seamlessly on mobile!)
# - In production or standalone server: specify wss://signaling.yourdomain.com
VITE_SIGNALING_SERVER_URL=""

# STUN Server URL:
# Multiple public STUN servers (Google and Cloudflare) are automatically configured by default.
# Specify a custom STUN server here if desired.
VITE_STUN_SERVER_URL="stun:stun.l.google.com:19302"

# TURN Server Credentials (Required for Carrier Symmetric NAT / Restrictive Firewalls):
# If connecting across cellular networks (LTE/5G) or restrictive corporate firewalls,
# a TURN server is required to relay UDP packets when direct P2P hole punching is blocked.
VITE_TURN_SERVER_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_PASSWORD=""
